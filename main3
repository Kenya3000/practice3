import java.util.*;

public class Main {
    public static List<String> topNWords(String text, int n) {
        if (text == null || text.isBlank() || n <= 0) {
            return List.of();
        }

        Map<String, Integer> freq = new HashMap<>();
        for (String word : text.toLowerCase().split("\\W+")) {
            if (!word.isEmpty()) {
                freq.put(word, freq.getOrDefault(word, 0) + 1);
            }
        }

        List> entries = new ArrayList<>(freq.entrySet());
        entries.sort((a, b) -> {
            int cmp = Integer.compare(b.getValue(), a.getValue());
            return cmp != 0 ? cmp : a.getKey().compareTo(b.getKey());
        });

        List<String> result = new ArrayList<>();
        for (int i = 0; i < Math.min(n, entries.size()); i++) {
            result.add(entries.get(i).getKey());
        }
        return result;
    }

    public static void main(String[] args) {
        String text = "java is great java is powerful " +
                      "python is great too but java is java";
        int N = 3;

        System.out.println(topNWords(text, N));
    }
}





