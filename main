import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class main3{
    public static void main(String[] args) {
        List<String> tasks = new ArrayList<>();
        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.println("""
                    Меню:
                    1  добавить задачу
                    2  удалить первую задачу
                    3  удалить задачу по номеру
                    4  показать все задачи
                    5  выход""");
            System.out.print("Введите команду: ");

            String line = scanner.nextLine().trim();

            if (line.equals("1")) {
                System.out.print("Введите текст задачи: ");
                String task = scanner.nextLine().trim();
                tasks.add(task);
                System.out.println("Задача добавлена.");
            } else if (line.equals("2")) {
                if (tasks.isEmpty()) {
                    System.out.println("Список пуст");
                } else {
                    System.out.println("Удалена задача: " + tasks.remove(0));
                }
            } else if (line.equals("3")) {
                if (tasks.isEmpty()) {
                    System.out.println("Список пуст");
                    continue;
                }
                System.out.print("Введите номер задачи: ");
                try {
                    int number = Integer.parseInt(scanner.nextLine().trim());
                    if (number < 1 || number > tasks.size()) {
                        System.out.println("Неверный номер");
                    } else {
                        System.out.println("Удалена задача: " + tasks.remove(number - 1));
                    }
                } catch (NumberFormatException e) {
                    System.out.println("Неверный номер");
                }
            } else if (line.equals("4")) {
                if (tasks.isEmpty()) {
                    System.out.println("Список пуст");
                } else {
                    for (int i = 0; i < tasks.size(); i++) {
                        System.out.println((i + 1) + ". " + tasks.get(i));
                    }
                }
            } else if (line.equals("5")) {
                System.out.println("Программа завершена.");
                return;
            } else {
                System.out.println("Неверная команда");
            }
        }
    }
}
